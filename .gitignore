node_modules/
npm-debug.log*
.DS_Store
.env
data/
# 스토어 제출물 — 스크린샷·그래픽은 결과물이라 넣지 않는다.
# 다만 심사답안·등록정보는 정책 판단이 적힌 글이라 잃으면 다시 못 만든다.
store-assets/*
!store-assets/제출용/
store-assets/제출용/*
!store-assets/제출용/*.md

# 안드로이드 빌드 — 서명 키스토어와 비밀번호가 들어있으므로 절대 커밋 금지
android-build/
*.keystore
*.jks
*.aab
*.apk
keystore-password.txt

# 디자인 캔버스 — 편집기까지 통째로 든 2.5MB 결과물이라 넣지 않는다.
# 작업 파일(*.dc.html · canvas.json · theme-gen.mjs)만 남기고 여기서 다시 만든다.
design/flip-flap-lobby.html

# 디자인 캔버스 작업 파일 — 2.4MB 결과물은 넣지 않는다
design-work/*.html
!design-work/*.dc.html
design-solo/*.html
!design-solo/*.dc.html
design-logo/*.html
!design-logo/*.dc.html
app-www/

# 안드로이드 서명 — 비밀번호가 들어간다. 절대 커밋 금지.
android/keystore.properties

# 파이어베이스 설정 — 프로젝트 식별자가 들어간다
android/app/google-services.json
design-lobby/*.html
!design-lobby/*.dc.html
